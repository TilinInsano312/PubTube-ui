      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pubtube-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pubtube_gateway_request_duration_seconds_bucket{job=\"pubtube-gateway\"}[5m])))",
          "legendFormat": "p95",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
