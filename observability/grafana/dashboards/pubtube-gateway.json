{
  "id": null,
  "uid": "pubtube-gateway",
  "title": "PubTube Gateway",
  "description": "Diagnostico tecnico del Gateway PubTube. Provisionado desde Git; Vue sera la UI funcional del producto. La row Future no demuestra disponibilidad de metricas.",
  "tags": [
    "pubtube",
    "gateway",
    "observability"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Gateway status",
      "description": "Estado del target Prometheus: UP=1, DOWN=0. No data indica que no se encuentra el target; revisar Prometheus.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pubtube-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pubtube-prometheus"
          },
          "expr": "up{job=\"pubtube-gateway\"}",
          "legendFormat": "{{instance}}",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Requests por minuto",
      "description": "Trafico real del Gateway, rate de 1 minuto multiplicado por 60. Requiere al menos dos scrapes.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pubtube-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pubtube-prometheus"
          },
          "expr": "sum(rate(pubtube_gateway_requests_total{job=\"pubtube-gateway\"}[1m])) * 60",
          "legendFormat": "Requests/min",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Requests por status class",
      "description": "Requests por segundo por status_class: 2xx, 3xx, 4xx y 5xx aparecen cuando hay datos; no se crean clases ficticias.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pubtube-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pubtube-prometheus"
          },
          "expr": "sum by (status_class) (rate(pubtube_gateway_requests_total{job=\"pubtube-gateway\"}[5m]))",
          "legendFormat": "{{status_class}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Errores 5xx",
      "description": "Errores de servidor por segundo. Cero si el target esta UP y no existe serie 5xx; no se provocan errores para poblar el panel.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pubtube-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.000001
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pubtube-prometheus"
          },
          "expr": "sum(rate(pubtube_gateway_requests_total{job=\"pubtube-gateway\",status_class=\"5xx\"}[5m])) or (0 * sum(up{job=\"pubtube-gateway\"} == 1))",
          "legendFormat": "5xx/s",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "p95 latency (target < 0.3 s)",
      "description": "p95 de latencia HTTP en segundos. Referencia del proyecto: p95 < 0.3 s (300 ms). Es diagnostico, no prueba de carga.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pubtube-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
