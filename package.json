{
  "name": "pubtube-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write package.json eslint.config.js prettier.config.js vite.config.ts vitest.config.ts \"tsconfig*.json\" \"src/**/*.{vue,ts,css}\"",
    "format:check": "prettier --check package.json eslint.config.js prettier.config.js vite.config.ts vitest.config.ts \"tsconfig*.json\" \"src/**/*.{vue,ts,css}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "@noble/hashes": "^1.8.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.3.11"
  }
}
